{
	// Inherit the root compiler options, including the workspace `paths` that
	// resolve `@temples/*` to their package sources for the editor and the
	// Bun dev flow. Bun follows the `extends` chain the same way.
	"extends": "../tsconfig.json",
	// Add the ambient declarations for Bun's asset imports (`*.html` as text,
	// `*.css` for their side effect). The default include already covers this
	// directory only, so the root declarations file is listed explicitly.
	"files": ["../types.d.ts"]
}
