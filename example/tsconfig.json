{
	"compilerOptions": {
		// Resolve the workspace package sources at runtime and for the editor,
		// so the example runs with `bun run dev` without a prior build.
		"paths": {
			"@temples/components": ["../packages/components/src/component.ts"],
			"@temples/components/reactive": ["../packages/components/src/reactive.ts"],
			"@temples/engine": ["../packages/engine/src/engine.ts"],
			"@temples/ssr": ["../packages/ssr/src/ssr.ts"],
			"@temples/jquery": ["../packages/jquery/src/jquery.ts"]
		}
	}
}
